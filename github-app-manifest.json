{
  "name": "Warden",
  "url": "https://YOUR-WARDEN-HOST.example",
  "public": false,
  "hook_attributes": {
    "url": "https://YOUR-WARDEN-HOST.example/webhooks/github",
    "active": true
  },
  "default_permissions": {
    "checks": "write",
    "statuses": "read",
    "pull_requests": "write",
    "contents": "read",
    "actions": "read",
    "metadata": "read"
  },
  "default_events": [
    "pull_request",
    "check_run",
    "check_suite",
    "status",
    "workflow_run",
    "push",
    "repository"
  ]
}
