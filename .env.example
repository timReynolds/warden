# Production Compose configuration. Copy to .env and replace the placeholders.
# Use the same password here and in WARDEN_POSTGRES_PASSWORD below.
# URL-encode reserved characters in the DATABASE_URL password.
DATABASE_URL=postgres://warden:CHANGE_ME@postgres:5432/warden
WARDEN_WEBHOOK_SECRET=replace-with-a-random-high-entropy-secret
WARDEN_APP_ID=123456
# Compose mounts WARDEN_PRIVATE_KEY_HOST_PATH at this container path.
# For native Bun commands, set this to the key's path on your machine.
WARDEN_PRIVATE_KEY_FILE=/run/secrets/warden_private_key
WARDEN_GITHUB_API_URL=https://api.github.com
WARDEN_JOB_LEASE_SECONDS=60
WARDEN_WORKER_POLL_MS=1000
PORT=3000
# Host port for production Compose (bound to loopback).
WARDEN_PORT=3000
WARDEN_POSTGRES_PASSWORD=CHANGE_ME
WARDEN_PRIVATE_KEY_HOST_PATH=./warden.private-key.pem
# For native development, use a local DATABASE_URL and a dedicated test DB;
# see CONTRIBUTING.md. compose.yml uses its own local fixture configuration.
